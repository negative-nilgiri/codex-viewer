# The deepest common host directory containing every session directory you want
# to expose. Docker mounts it read-only as /sources inside the API container.
# When tracking only one Codex installation, this can be its sessions directory.
VIEWER_SOURCES_ROOT=/absolute/path/to/your/.codex/sessions

# Writable durable conversation exports. A relative path is resolved from this
# repository. Set an absolute path here if archives should live on backed-up storage.
VIEWER_ARCHIVES_ROOT=./archives

# Directory recursively containing ordinary Markdown documents to browse.
# It is mounted read-only; add, edit, and remove documents from the host.
VIEWER_DOCUMENTS_ROOT=./documents

# The local browser address will be http://localhost:<VIEWER_PORT>.
VIEWER_PORT=8080
