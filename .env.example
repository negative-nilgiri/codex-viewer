# Writable durable conversation exports. A relative path is resolved from this
# repository. Set an absolute path here if archives should live on backed-up
# storage, and point the archive source in config/sources.toml at the same place.
VIEWER_ARCHIVES_ROOT=./archives

# Writable session-title metadata. Keep this separate from config/ so titles
# can be edited from the browser and updated atomically.
VIEWER_METADATA_ROOT=./metadata

# Directory recursively containing ordinary Markdown documents to browse.
# The viewer only reads it; add, edit, and remove documents directly.
VIEWER_DOCUMENTS_ROOT=./documents

# Browser port (just open) and API port. The justfile defaults are below.
# VIEWER_PORT=41730
# VIEWER_API_PORT=41731
